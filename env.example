VITE_USE_MOCK=false
# Browser: gunakan same-origin proxy Vercel
VITE_API_PATH=/api/gas

# Set variabel berikut di Vercel Project Settings > Environment Variables.
# JANGAN beri prefix VITE_ karena harus tetap server-side.
GAS_API_URL=https://script.google.com/macros/s/DEPLOYMENT_ID/exec
GAS_PROXY_SECRET=ganti-dengan-random-secret-panjang
